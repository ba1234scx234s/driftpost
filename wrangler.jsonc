{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "driftpost",
  "main": "worker/index.ts",
  // The Cloudflare account Driftpost is deployed to.
  "account_id": "3202f1d188981169d5f46ed002c533a6",
  "compatibility_date": "2025-09-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Per-IP limits on requests that reach other sites. Feed refreshes that hit the shared
  // cache don't count. namespace_id is just a unique number for this account.
  "ratelimits": [
    { "name": "FETCH_LIMIT", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
    { "name": "ICON_LIMIT", "namespace_id": "1002", "simple": { "limit": 200, "period": 60 } }
  ],
  "observability": { "enabled": false }
}
